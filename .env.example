# Copy to .env and adjust. Never commit the real .env.

# --- MongoDB ---
MONGO_INITDB_ROOT_USERNAME=archive
MONGO_INITDB_ROOT_PASSWORD=change-me-in-prod
MONGO_URI=mongodb://archive:change-me-in-prod@mongo:27017/?authSource=admin

# --- Redis ---
REDIS_ADDR=redis:6379

# --- MinIO (object store for merchant-uploaded images) ---
# Credentials for the MinIO root user (and the bucket-init client). Use long random values in prod.
MINIO_ACCESS_KEY=archive-media
MINIO_SECRET_KEY=change-me-media-secret
MINIO_BUCKET=media
# Endpoint catalog uses inside the compose network (host:port, no scheme).
MINIO_ENDPOINT=minio:9000
# Public base URL of the object store as seen by the browser (bucket is public-read).
# In prod this is the Nginx-fronted media host, e.g. https://media.tutienda.com.ar
PUBLIC_MEDIA_BASE=http://localhost:9000
# Host port mappings for MinIO (API + web console).
MINIO_HOST_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Service ports (internal) ---
CATALOG_ADDR=:8081
INVENTORY_ADDR=:8082
ORDERS_ADDR=:8083
ACCOUNTS_ADDR=:8084
GATEWAY_ADDR=:8080

# --- Service URLs (used by gateway + orders for inter-service calls) ---
CATALOG_URL=http://catalog:8081
INVENTORY_URL=http://inventory:8082
ORDERS_URL=http://orders:8083
ACCOUNTS_URL=http://accounts:8084

# --- Auth ---
# dev (default) or prod. In prod, accounts/gateway refuse to start if JWT_SECRET is unset or still the
# known dev default (see services/internal/platform/config/config.go), and demo seeding defaults to off.
ENV=dev
# Shared secret signing merchant/admin session tokens (HS256). Use a long random value in prod.
JWT_SECRET=change-me-to-a-long-random-secret
# Seeds the demo store + a publicly-documented super-admin login (admin@tutienda.store) on an empty DB.
# Defaults to on when ENV is not prod (dev/demo convenience), off when ENV=prod. Set explicitly to
# override either way. If you do seed in a real deployment, rotate the demo/admin passwords immediately.
SEED_DEMO_DATA=true

# --- Host port mappings (change if a port is already in use) ---
GATEWAY_HOST_PORT=8080
WEB_HOST_PORT=3000

# --- Gateway ---
# Allowed origin for the storefront (CORS). Match where the browser loads the web app.
WEB_ORIGIN=http://localhost:3000
# Sliding-window rate limit: max requests per window (seconds)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Reservations ---
# How long a stock reservation is held before the janitor releases it (seconds)
RESERVATION_TTL_SECONDS=900

# --- Web (SvelteKit) ---
# Public base URL of the gateway, as seen by the browser
PUBLIC_API_BASE=http://localhost:8080
# Gateway URL reachable from inside the web container (server-side rendering)
INTERNAL_API_BASE=http://gateway:8080
# Default store slug for the browser API client fallback (the seeded demo store).
# Storefronts resolve the store from the /store/[slug] route param, not this.
PUBLIC_STORE_SLUG=system-archive
# SaaS brand name — shown on the marketing landing, auth pages and merchant dashboard. Change in one place.
PUBLIC_BRAND_NAME=TuTienda
# Root domain, used only for copy on the landing/signup (each store's real URL is {domain}/store/{slug}).
PUBLIC_ROOT_DOMAIN=tutienda.com.ar
